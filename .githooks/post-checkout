#!/bin/sh
# Auto-regenerate SchoolSchedule.xcodeproj when switching branches (`$3 == 1`).
set -e

[ "$3" = "1" ] || exit 0

XCODEGEN="$(command -v xcodegen || true)"
if [ -z "$XCODEGEN" ] && [ -x "$HOME/xcodegen/bin/xcodegen" ]; then
    XCODEGEN="$HOME/xcodegen/bin/xcodegen"
fi

if [ -n "$XCODEGEN" ]; then
    "$XCODEGEN" generate
fi
